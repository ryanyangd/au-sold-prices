# Copy to .env.local and adjust. No secrets belong here (all NEXT_PUBLIC_* values are public).
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Microsoft Entra External ID (leave all three empty to use the dev auth provider)
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_AUTHORITY=
NEXT_PUBLIC_ENTRA_API_SCOPE=
